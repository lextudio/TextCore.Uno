<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LeXtudio.UI.Text.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>LeXtudio</Authors>
    <Company>LeXtudio</Company>
    <Version>$(GitVersion_SemVer)</Version>
    <Description>Cross-platform text/IME primitives (CoreTextEditContext + Win32/macOS/Linux IME adapters). Consumers resolve their own native window handle and drive the adapter through CoreTextEditContext; this library has no dependency on Uno, WPF, WinUI, or any other UI framework.</Description>
    <PackageId>LeXtudio.UI.Text.Core</PackageId>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>company_logo_512.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Unix' and Exists('/System/Library/Frameworks/AppKit.framework')">
    <TextCoreMacInputSource>$(MSBuildProjectDirectory)/Native/MacOS/TextCoreNativeMacInput.mm</TextCoreMacInputSource>
    <TextCoreMacInputOutput>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/libTextCoreNativeMacInput.dylib</TextCoreMacInputOutput>
    <GetCopyToOutputDirectoryItemsDependsOn>$(GetCopyToOutputDirectoryItemsDependsOn);AddTextCoreMacBridgeToCopyItems</GetCopyToOutputDirectoryItemsDependsOn>
  </PropertyGroup>

  <PropertyGroup>
    <MacImeDylibPath Condition="Exists('$(TextCoreMacInputOutput)')">$(TextCoreMacInputOutput)</MacImeDylibPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../images/company_logo_512.png" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/LeXtudio.UI.Text.Core.targets" Pack="true" PackagePath="buildTransitive/LeXtudio.UI.Text.Core.targets" />
  </ItemGroup>

  <ItemGroup Condition="'$(MacImeDylibPath)' != ''">
    <None Include="$(MacImeDylibPath)" Pack="true" PackagePath="runtimes/osx/native/libTextCoreNativeMacInput.dylib" />
    <None Include="$(MacImeDylibPath)" Pack="true" PackagePath="runtimes/osx-x64/native/libTextCoreNativeMacInput.dylib" />
    <None Include="$(MacImeDylibPath)" Pack="true" PackagePath="runtimes/osx-arm64/native/libTextCoreNativeMacInput.dylib" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="EnsureMacNativeBridgeForPack" BeforeTargets="Pack" DependsOnTargets="BuildTextCoreMacInputBridge">
    <Message Importance="high" Text="[LeXtudio.UI.Text.Core] macOS native bridge path: $(MacImeDylibPath)" Condition="'$(MacImeDylibPath)' != ''" />
    <Error
      Condition="'$(OS)' == 'Unix' and Exists('/System/Library/Frameworks/AppKit.framework') and '$(MacImeDylibPath)' == ''"
      Text="macOS packaging requires libTextCoreNativeMacInput.dylib. Build the native bridge first so the dylib is produced." />
  </Target>

  <Target Name="BuildTextCoreMacInputBridge"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Unix' and Exists('/System/Library/Frameworks/AppKit.framework') and Exists('$(TextCoreMacInputSource)')">
    <Message Importance="high" Text="[LeXtudio.UI.Text.Core] Building native macOS IME bridge: $(TextCoreMacInputOutput)" />
    <Exec Command="xcrun clang++ -dynamiclib -fobjc-arc -framework AppKit -framework Foundation -o &quot;$(TextCoreMacInputOutput)&quot; &quot;$(TextCoreMacInputSource)&quot;" />
  </Target>

  <Target Name="AddTextCoreMacBridgeToCopyItems"
          DependsOnTargets="BuildTextCoreMacInputBridge"
          Condition="'$(OS)' == 'Unix' and Exists('/System/Library/Frameworks/AppKit.framework') and Exists('$(TextCoreMacInputOutput)')">
    <ItemGroup>
      <ContentWithTargetPath Include="$(TextCoreMacInputOutput)">
        <TargetPath>libTextCoreNativeMacInput.dylib</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(TextCoreMacInputOutput)">
        <TargetPath>runtimes/osx-arm64/native/libTextCoreNativeMacInput.dylib</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(TextCoreMacInputOutput)">
        <TargetPath>runtimes/osx-x64/native/libTextCoreNativeMacInput.dylib</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
